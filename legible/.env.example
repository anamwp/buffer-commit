# Buffer app client: https://publish.buffer.com/settings/api -> App Clients -> New Client (private)
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must match a registered redirect URI exactly (HTTPS, even on localhost)
REDIRECT_URI=https://localhost:3000/auth/buffer/callback

# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32   (exactly 32 bytes)
TOKEN_ENC_KEY=

# Neon Postgres. Leave empty in local dev to use an embedded PGlite database in .data/
DATABASE_URL=

# Optional: enables "Suggest fixes" (alt text + rewrite). Without it, rules and quick fixes still work.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
